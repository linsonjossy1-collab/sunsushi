     public function getAllDealProducts() {
        $bundled_data = array();
        $bundled_details_query= $this->db->query("SELECT * FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_bundle ORDER BY sort_order");
        foreach ($bundled_details_query->rows as $bundled_detail) {
            $prdata = $this->db->query("SELECT DISTINCT dealcondition,price,suggestion_condition FROM " . DB_PREFIX . (isset($this->session->data['shadow_menu']) ? $this->session->data['shadow_menu'] : '') .  "product WHERE product_id='".(int)$bundled_detail['product_id']."'");
            //print_r($prdata);
            if($prdata->row['dealcondition']=='H' || $prdata->row['dealcondition'] =='L'){//exclude half and half deal #TODO
                continue;
            }  
             $bundled_data[$bundled_detail['product_id']][$bundled_detail['bundle_id']]=array('items'=>array(),'bundle_name'=>$bundled_detail['bundle_name'],'bundle_quantity'=>$bundled_detail['bundle_quantity'],'ismainitem'=>$bundled_detail['ismainitem'],'suggestion_condition'=>$prdata->row['suggestion_condition']);
            //$bundled_data[$bundled_detail['product_id']];
            for($i=0;$i<$bundled_detail['bundle_quantity'];$i++){
                $sub_products = array();    
                $bundled_prodt_query = $this->db->query("SELECT product_id FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_bundle_items pit  WHERE pit.bundle_id = '" . (int) $bundled_detail['bundle_id'] . "'");
                foreach ($bundled_prodt_query->rows as $bundled_prodt) {
                    //$bundled_option_query = $this->db->query("SELECT product_option_value_id FROM " . DB_PREFIX . "product_bundle_items_options pot  WHERE pot.bundle_id = '" . (int) $bundled_detail['bundle_id'] . "' AND product_id = '" . $bundled_prodt['product_id'] . "'");
                   // $options=array();
                    $sub_products[]=$bundled_prodt['product_id'];
                   /* foreach ($bundled_option_query->rows as $option) {
                        $options[]=$option['product_option_value_id'];
                    }
                    $sub_products[] = array(
                        'bundled_product_id' => $bundled_prodt['product_id'],
                        'bundled_product_options' => $options
                    );*/
                }
                $bundled_data[$bundled_detail['product_id']][$bundled_detail['bundle_id']][$i] = $sub_products; /* array(
                    'product_id' => $bundled_detail['product_id'],
                    'bundle_id' => $bundled_detail['bundle_id'],
                    'bundled_products' => $sub_products
                );*/
            }
        }
        return $bundled_data;
       // print_r($bundled_data);//die();
        
        //print_r($bundled_data);die();/////
    }
    
    public function getSingleBundleItems($bundle_id){
        $items=array();
        $bundled_prodt_query = $this->db->query("SELECT * FROM " . DB_PREFIX . "product_bundle_items pbi  WHERE pbi.bundle_id = '" . (int) $bundle_id . "'");
