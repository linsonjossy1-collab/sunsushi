      public function getProductCategories($product_id) {

        $category_data = array();

        $query = $this->db->query("SELECT * FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_to_category c  WHERE c.product_id = '" . (int) $product_id . "'");
        $cat_path ='';
        foreach ($query->rows as $result) {
           // echo $result['category_id'] . "--" . $result['name']."</br>";
              $cat_path .= ','.$this->getPath($result['category_id']);
          
        }

//echo $cat_path."<br>";
        //print_r($category_data);
        
        $cat_path= array_unique(explode(',', trim($cat_path,',')));
        
        return $cat_path;
    }

    public function getPath($category_id) {
        //$categories =','+$category_id+'';
        $query = $this->db->query("SELECT  parent_id FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "category c  WHERE c.category_id = '" . (int) $category_id . "'");
        //$cat_name = false;
        if ($query->row['parent_id'] != 0) {
            //echo "s";
           return $category_id .','. $this->getPath($query->row['parent_id']) ;
        }
            return $category_id;
        
       // return $cat_name;
    }
