    public function getProductBundledItems($product_id) {
        $bundled_data = array();
        $bundled_data_query = $this->db->query("SELECT * FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_bundle pb  WHERE pb.product_id = '" . (int) $product_id . "' ORDER BY pb.sort_order");
        foreach ($bundled_data_query->rows as $k => $bundled_items) {
            $bundled_data[$k] = $bundled_items;            
            $bundled_prodt_query = $this->db->query("SELECT pit.*,pr.sort_order FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_bundle_items pit  LEFT JOIN " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product pr ON (pit.product_id = pr.product_id) WHERE pit.bundle_id = '" . (int) $bundled_items['bundle_id'] . "' ORDER BY pr.sort_order ASC ");
            if (!empty($bundled_prodt_query->rows)) {
                foreach ($bundled_prodt_query->rows as $i => $bundled_prodt) {
                    $bundled_data[$k]['products'][$i]['product_id'] = $bundled_prodt['product_id'];
                    $bundled_data[$k]['products'][$i]['extra_price'] = $bundled_prodt['extra_price'];
                    $bundled_option_query = $this->db->query("SELECT * FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_bundle_items_options pot  WHERE pot.bundle_id = '" . (int) $bundled_items['bundle_id'] . "' AND product_id = '" . $bundled_prodt['product_id'] . "'");
                    if (!empty($bundled_option_query->rows)) {

                        foreach ($bundled_option_query->rows as $m => $option) {
                            $bundled_data[$k]['products'][$i]['optionvalues'][] = $option['product_option_value_id'];
                        }
                    }
                }
            }
        }
        return $bundled_data;
    }

    public function getBundledProductOptions($bundle_id, $product_id) {
        $optionvalues = array();
        $bundled_option_query = $this->db->query("SELECT * FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_bundle_items_options pot  WHERE pot.bundle_id = '" . (int) $bundle_id . "' AND product_id = '" . $product_id . "'");
        if (!empty($bundled_option_query->rows)) {

            foreach ($bundled_option_query->rows as $m => $option) {
               $optionvalues[] = $option['product_option_value_id'];
            }
        }
        return $optionvalues;
    }
     public function getIndealProductOptions($bundle_id, $product_id) {
        $optionvalues = array();
        $bundled_option_query = $this->db->query("SELECT pot.*,pov.product_option_value_id,pov.product_option_id FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_bundle_items_options pot JOIN  " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_option_value pov ON (pot.product_option_value_id = pov.product_option_value_id) WHERE pot.bundle_id = '" . (int) $bundle_id . "' AND pot.product_id = '" . $product_id . "'");
        $optionvalues = array();
        if (!empty($bundled_option_query->rows)) {

            foreach ($bundled_option_query->rows as $option) {
                if(!isset($optionvalues[$option['product_option_id']])){
                    $optionvalues[$option['product_option_id']]=[];
                }
               $optionvalues[$option['product_option_id']][] = $option['product_option_value_id'];
            }
        }
        return $optionvalues;
    }
