    public function getProductSideItems($product_id){
        $product_related_data = array();
        $query = $this->db->query("SELECT * FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_side_dish WHERE product_id = '" . (int) $product_id . "'");
