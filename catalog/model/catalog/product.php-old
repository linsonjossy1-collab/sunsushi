    public function checkProductToppings($product_id){
        $status = false;
        $prodt_topping_qry = $this->db->query("SELECT product_toppings FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product WHERE product_id = '" . (int)$product_id . "'");
        $topping_data = unserialize($prodt_topping_qry->row['product_toppings']);
        if(!empty($topping_data)){
            $status = true;
        }
        return $status;
    }
    public function getProductDressings($product_id){
       $prodt_dressing_qry = $this->db->query("SELECT product_dressings FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product WHERE product_id = '" . (int)$product_id . "'");
        $dressing_data = unserialize($prodt_dressing_qry->row['product_dressings']);
        $product_dressing_data=array();
        if(!empty($dressing_data)){
            foreach ($dressing_data as $dressing_id) {
                $dquery = $this->db->query("SELECT * FROM `" . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "dressing` d LEFT JOIN " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "dressing_description dd ON (d.dressing_id = dd.dressing_id) WHERE d.dressing_id ='".(int)$dressing_id."' AND d.swap_option=0  AND dd.language_id = '" . (int)$this->config->get('config_language_id') . "'");
                if($dquery->num_rows){
                    $dressing_value_data =  array();
                    $dressing_value_qry = $this->db->query("SELECT * FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "dressing_value dv LEFT JOIN " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "dressing_value_description dvd ON(dvd.dressing_value_id=dv.dressing_value_id) WHERE dv.dressing_id = '" . (int)$dressing_id . "' AND dvd.language_id = '" . (int)$this->config->get('config_language_id') . "' ORDER BY dv.sort_order ASC ");
                    if($dressing_value_qry->num_rows){
                        foreach($dressing_value_qry->rows as $dressing_value){
                            $dressing_value_data[] = array(
                                'dressing_value_id' =>  $dressing_value ['dressing_value_id'],
                                'name' =>  $dressing_value ['name'],
                                'shortcode' =>  $dressing_value ['shortcode'],
                                'sort_order' =>  $dressing_value ['sort_order']
                            );
                        }
                    }
                    $product_dressing_data[]=array(
                        'dressing_id'=>$dressing_id,
                        'name' => $dquery->row['name'],
                        'sort_order' => $dquery->row['sort_order'],
                        'dressing_values' =>$dressing_value_data
                    );
                }
            }
        }        
        return $product_dressing_data;    
    }
    public function getToppings($mstatus=false) {
        $topping_data = array();
        $sql = "SELECT * FROM `" . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "topping` o LEFT JOIN " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "topping_description od ON (o.topping_id = od.topping_id) WHERE od.language_id = '" . (int)$this->config->get('config_language_id') . "' ORDER BY o.sort_order ASC";
        $query = $this->db->query($sql);
        $this->load->model('tool/image');
       if($query->num_rows){
           foreach($query->rows as $topping){
                    $topping_value_data =  array();
                    $topping_value_qry = $this->db->query("SELECT * FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "topping_value tv LEFT JOIN " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "topping_value_description tvd ON(tvd.topping_value_id=tv.topping_value_id) WHERE tv.topping_id = '" . (int)$topping['topping_id'] . "' AND tvd.language_id = '" . (int)$this->config->get('config_language_id') . "' ORDER BY tv.sort_order ASC ");
                    if($topping_value_qry->num_rows){
                        foreach($topping_value_qry->rows as $topping_value){
                            if ($topping_value['pos_image'] && !empty($topping_value['pos_image'])) {
                                $fontparts = explode(':',$topping_value['pos_image']);
                                    if(is_array($fontparts) && isset($fontparts[0])){
                                        if ($fontparts[0]=='F'){
                                            $image = $topping_value['pos_image'];
                                        }
                                        else {
                                            $image = 'I:data:images/png;base64,' . base64_encode(file_get_contents($this->model_tool_image->resize($topping_value['pos_image'], $this->config->get('config_image_pos_width'), $this->config->get('config_image_pos_height'))));
                                        }
                                    }
                                else {
                                    $image = false;
                                }
                            }else {
                                $image = false;
                            }
                            $topping_value_data[] = array(
                                'topping_value_id' =>  $topping_value ['topping_value_id'],
                                'name' =>  $topping_value ['name'],
                                'shortcode' =>  strip_tags(html_entity_decode($topping_value['shortcode'], ENT_QUOTES, 'UTF-8')),
                                'price' =>  $topping_value ['price'],
                                'sort_order' =>  $topping_value ['sort_order'],
                                'epos_fgcolor' =>  $topping_value ['epos_fgcolor'],
                                'epos_bgcolor' =>  $topping_value ['epos_bgcolor'], 
                                'image' => $image,
                            );
                        }
                    }
               $topping_data[]=array(
                   'topping_id'=>$topping['topping_id'],
                   'name' => $topping['name'],
                   'sort_order' => $topping['sort_order'],
                   'swap_option' => $topping['swap_option'],
                   'swap_buttons' => ($mstatus)?json_encode(unserialize($topping['swap_buttons'])):unserialize($topping['swap_buttons']),
                   'topping_values' =>($mstatus)?json_encode($topping_value_data):$topping_value_data
               );
           }
       } 
        return $topping_data;;
    }
     public function getDressings($mstatus=false) {
        $dressing_data = array();
        $this->load->model('tool/image');
        $sql = "SELECT * FROM `" . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "dressing` d LEFT JOIN " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "dressing_description dd ON (d.dressing_id = dd.dressing_id) WHERE dd.language_id = '" . (int)$this->config->get('config_language_id') . "' ORDER BY d.sort_order ASC";
        $query = $this->db->query($sql);
       if($query->num_rows){
           foreach($query->rows as $dressing){
                    $dressing_value_data =  array();
                    $dressing_value_qry = $this->db->query("SELECT * FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "dressing_value dv LEFT JOIN " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "dressing_value_description dvd ON(dvd.dressing_value_id=dv.dressing_value_id) WHERE dv.dressing_id = '" . (int)$dressing['dressing_id'] . "' AND dvd.language_id = '" . (int)$this->config->get('config_language_id') . "' ORDER BY dv.sort_order ASC ");
                    if($dressing_value_qry->num_rows){
                        foreach($dressing_value_qry->rows as $dressing_value){
                            if ($dressing_value['pos_image'] && !empty($dressing_value['pos_image'])) {
                                $fontparts = explode(':',$dressing_value['pos_image']);
                                    if(is_array($fontparts) && isset($fontparts[0])){
                                        if ($fontparts[0]=='F'){
                                            $image = $dressing_value['pos_image'];
                                        }
                                        else {
                                            $image = 'I:data:images/png;base64,' . base64_encode(file_get_contents($this->model_tool_image->resize($dressing_value['pos_image'], $this->config->get('config_image_pos_width'), $this->config->get('config_image_pos_height'))));
                                        }
                                    }
                                else {
                                    $image = false;
                                }
                            }else {
                                $image = false;
                            }
                            $dressing_value_data[] = array(
                                'dressing_value_id' =>  $dressing_value ['dressing_value_id'],
                                'name' =>  $dressing_value ['name'],
                                'shortcode' =>  strip_tags(html_entity_decode($dressing_value['shortcode'], ENT_QUOTES, 'UTF-8')),
                                'sort_order' =>  $dressing_value ['sort_order'],
                                'image'=>$image
                            );
                        }
                    }
               $dressing_data[]=array(
                   'dressing_id'=>$dressing['dressing_id'],
                   'swap_option'=>$dressing['swap_option'],
                   'name' => $dressing['name'],
                   'sort_order' => $dressing['sort_order'],
                   'dressing_values' =>($mstatus)?json_encode($dressing_value_data):$dressing_value_data
               );
           }
       }
        return $dressing_data;;
	}
        
        public function getToppingsDressingsCondition($product_id) {
            $prodt_topping_qry = $this->db->query("SELECT free_toppings,maximum_toppings,maximum_dressings FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product WHERE product_id = '" . (int)$product_id . "'");

            return $prodt_topping_qry->row;
        } 
    public function getProductname($product_id) {
        $query = $this->db->query("SELECT p.product_id, pd.name AS name FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product p LEFT JOIN " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_description pd ON (p.product_id = pd.product_id)  WHERE p.product_id = '" . (int)$product_id . "' AND pd.language_id = '" . (int)$this->config->get('config_language_id') . "'");
        return $query->row['name'];
    }  
    public function getProductCount() {
        $query = $this->db->query("SELECT count(*) as cnt FROM " . DB_PREFIX . "product  WHERE status = '1' ");		
        return $query->row['cnt'];;
    }   
    //SELECT pr.name,pr.description FROM `product_bundle_items` pi JOIN `product_bundle` pb ON(pi.bundle_id=pb.bundle_id)  JOIN `product_description` pr ON(pb.product_id=pr.product_id) WHERE pi.product_id=10000
     public function getProducttoDeals($product_id) {
        $query = $this->db->query("SELECT pr.product_id,pr.name,pr.description,p.dealsuggestion FROM " . DB_PREFIX .  "product_bundle_items pi JOIN " . DB_PREFIX .  "product_bundle pb ON (pi.bundle_id=pb.bundle_id) JOIN " . DB_PREFIX .  "product_description pr ON (pb.product_id=pr.product_id) JOIN " . DB_PREFIX .  "product p ON (pr.product_id=p.product_id)  WHERE pi.product_id = ".$product_id." AND p.dealsuggestion=1 AND p.status=1 LIMIT 4 ");//  LIMIT 3
        return $query->rows;
    } 
}
