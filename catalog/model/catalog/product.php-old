    public function getProductSideDishes($product_id) {
        $product_data = array();

        $query = $this->db->query("SELECT * FROM " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_side_dish pr LEFT JOIN " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product p ON (pr.side_dish_id = p.product_id) LEFT JOIN " . DB_PREFIX . ((isset($this->session->data['shadow_menu']) && ($this->session->data['shadow_menu'] == $this->config->get('config_store_id')) )? $this->session->data['shadow_menu'] : '' ) . "product_to_store p2s ON (p.product_id = p2s.product_id) WHERE pr.product_id = '" . (int) $product_id . "' AND p.status = '1' AND p.date_available <= NOW() AND p2s.store_id = '" . (int) $this->config->get('config_store_id') . "'");

        foreach ($query->rows as $result) {
            $product_data[$result['side_dish_id']] = $this->getProduct($result['side_dish_id']);
        }

        return $product_data;
    }
