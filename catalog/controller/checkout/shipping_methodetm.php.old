                                        }
                                    }
                                    if($del_btwn) {
                                        $status_chk = true;
                                        $cat_data = $this->model_catalog_category->getCategory($prd_category_id); 
                                        $no_delivery['option'][$product['name']]['time']  = $del_btwn;
